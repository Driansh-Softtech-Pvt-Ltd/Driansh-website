MAIL_USER=
MAIL_PASS=

MAIL_TO=support@driansh.com 

MONGODB_URI=
DB_NAME=

# Public site URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://driansh.com

# Admin dashboard (/admin/leads) password
ADMIN_PASSWORD=

# POST /api/leads: when set, callers must send it as `Authorization: Bearer <token>`
# or `x-api-key`. Leave empty to keep the endpoint open (honeypot + rate limit only).
LEADS_API_TOKEN=

# Optional: restrict the lead API to one origin instead of any (CORS)
LEADS_API_ORIGIN=

# Chatwoot webhook secret: https://<site>/api/webhooks/chatwoot?token=<value>
CHATWOOT_WEBHOOK_TOKEN=

# Optional: salt for anonymous daily visitor hashes (any random string)
ANALYTICS_SALT=

# Google Search Console HTML-tag verification code (content="...")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
