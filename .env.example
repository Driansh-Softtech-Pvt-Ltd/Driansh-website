# Outgoing mail. These are the same variable names EngageOne (Chatwoot) uses,
# so the credentials that already send as support@driansh.com can be copied
# straight from its .env.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DOMAIN=
# Leave unset unless the relay needs it: SSL on from the first byte (port 465).
SMTP_SSL=
# Set to false only for a relay that cannot upgrade to TLS.
SMTP_ENABLE_STARTTLS_AUTO=
# The From address on the notification.
MAILER_SENDER_EMAIL=support@driansh.com

# Legacy Gmail transport, used only when SMTP_ADDRESS is empty.
MAIL_USER=
MAIL_PASS=

# Where enquiries are delivered.
MAIL_TO=support@driansh.com

MONGODB_URI=
DB_NAME=

# Public site URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://driansh.com

# Admin dashboard (/admin/leads) password
ADMIN_PASSWORD=

# POST /api/leads: when set, callers must send it as `Authorization: Bearer <token>`
# or `x-api-key`. Leave empty to keep the endpoint open (honeypot + rate limit only).
LEADS_API_TOKEN=

# Optional: restrict the lead API to one origin instead of any (CORS)
LEADS_API_ORIGIN=

# Chatwoot webhook secret: https://<site>/api/webhooks/chatwoot?token=<value>
CHATWOOT_WEBHOOK_TOKEN=

# Optional: salt for anonymous daily visitor hashes (any random string)
ANALYTICS_SALT=

# Google Search Console HTML-tag verification code (content="...")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
